+/**
+ * Extra headers for re-INVITEs of this call (CME Phone: Call-Info remotecc)
+ *
+ * @param call Call object
+ * @param hdrs Headers incl. CRLF, NULL to clear
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int call_set_reinvite_hdrs(struct call *call, const char *hdrs)
+{
+	if (!call || !call->sess)
+		return EINVAL;
+
+	return sipsess_set_reinvite_hdrs(call->sess, hdrs);
+}
