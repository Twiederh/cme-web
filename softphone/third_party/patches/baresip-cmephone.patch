+/**
+ * Extra header only for the REGISTER requests of a User-Agent
+ * (CME Phone: Cisco "Supported: ...,X-cisco-sis-7.0.0,..." like Jabber)
+ *
+ * @param ua    User-Agent
+ * @param name  Header name, NULL to clear
+ * @param value Header value
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int ua_set_reg_hdr(struct ua *ua, const char *name, const char *value)
+{
+	struct list hdrs = LIST_INIT;
+	struct le *le;
+	int err = 0;
+
+	if (!ua)
+		return EINVAL;
+
+	if (name)
+		err = custom_hdrs_add(&hdrs, name, "%s", value ? value : "");
+	if (err)
+		return err;
+
+	LIST_FOREACH(&ua->regl, le)
+		reg_set_custom_hdrs(le->data, &hdrs);
+
+	list_flush(&hdrs);
+	return 0;
+}
