 		return 0;
 
 	if (contact->uri && strchr(contact->uri, ':'))
-		return re_hprintf(pf, "Contact: <%s>\r\n", contact->uri);
+		return re_hprintf(pf, "Contact: <%s%s%s>%s%s\r\n", contact->uri,
+				  g_uri_params ? ";" : "",
+				  g_uri_params ? g_uri_params : "",
+				  g_hdr_params ? ";" : "",
+				  g_hdr_params ? g_hdr_params : "");
 	else
-		return re_hprintf(pf, "Contact: <sip:%s@%J%s>\r\n",
+		return re_hprintf(pf, "Contact: <sip:%s@%J%s%s%s>%s%s\r\n",
 				  contact->uri,
 				  contact->addr,
-				  sip_transp_param(contact->tp));
+				  sip_transp_param(contact->tp),
+				  g_uri_params ? ";" : "",
+				  g_uri_params ? g_uri_params : "",
+				  g_hdr_params ? ";" : "",
+				  g_hdr_params ? g_hdr_params : "");
 }
