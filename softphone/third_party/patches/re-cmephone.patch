diff --git a/src/sip/contact.c b/src/sip/contact.c
index 6703384..59d9df2 100644
--- a/src/sip/contact.c
+++ b/src/sip/contact.c
@@ -12,6 +12,40 @@
 #include <re_sa.h>
 #include <re_msg.h>
 #include <re_sip.h>
+#include <re_mem.h>
+
+
+/* CME Phone: Parameter für jeden eigenen Contact (eine App, ein Konto).
+ * uri_params stehen in <...> (z.B. pn-prid=...), hdr_params dahinter (z.B. +u.sip!devicename...). */
+static char *g_uri_params;
+static char *g_hdr_params;
+
+
+int sip_contact_set_params(const char *uri_params, const char *hdr_params)
+{
+	int err = 0;
+
+	g_uri_params = mem_deref(g_uri_params);
+	g_hdr_params = mem_deref(g_hdr_params);
+	if (uri_params && *uri_params)
+		err |= str_dup(&g_uri_params, uri_params);
+	if (hdr_params && *hdr_params)
+		err |= str_dup(&g_hdr_params, hdr_params);
+
+	return err;
+}
+
+
+const char *sip_contact_uri_params(void)
+{
+	return g_uri_params;
+}
+
+
+const char *sip_contact_hdr_params(void)
+{
+	return g_hdr_params;
+}
 
 
 /**
