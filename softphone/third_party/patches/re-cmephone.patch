index 0165241..24bccb6 100644
--- a/src/sipsess/sess.c
+++ b/src/sipsess/sess.c
@@ -152,6 +152,7 @@ static void destructor(void *arg)
 	mem_deref(sess->cuser);
 	mem_deref(sess->ctype);
 	mem_deref(sess->close_hdrs);
+	mem_deref(sess->reinvite_hdrs);
 	mem_deref(sess->hdrs);
 	mem_deref(sess->desc);
 	mem_deref(sess->sock);
@@ -394,3 +395,22 @@ enum sdp_neg_state sipsess_sdp_neg_state(const struct sipsess *sess)
 {
 	return sess ? sess->neg_state : SDP_NEG_NONE;
 }
+
+
+/**
+ * Set extra headers for the next re-INVITEs (CME Phone: Call-Info remotecc)
+ *
+ * @param sess SIP Session
+ * @param hdrs Headers incl. CRLF, NULL to clear
+ *
+ * @return 0 if success, otherwise errorcode
+ */
+int sipsess_set_reinvite_hdrs(struct sipsess *sess, const char *hdrs)
+{
+	if (!sess)
+		return EINVAL;
+
+	sess->reinvite_hdrs = mem_deref(sess->reinvite_hdrs);
+
+	return hdrs ? str_dup(&sess->reinvite_hdrs, hdrs) : 0;
+}
