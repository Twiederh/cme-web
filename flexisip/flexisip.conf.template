##
## Flexisip als Push-Gateway vor Cisco CME
## =========================================
##
##  iPhone/iPad/Mac (liblinphone)  --REGISTER/INVITE-->  Flexisip (Docker-Host)  --REGISTER/INVITE-->  CME
##                                                      |
##                                                      +-- schläft das Gerät: HTTP -> cme-push-relay
##                                                          -> Local Push (Heim-WLAN) oder APNs VoIP-Push
##
## Die App registriert sich mit Identität sip:<nst>@<SIP_DOMAIN> und nutzt Flexisip als Outbound-Proxy.
## SIP_DOMAIN muss ein NAME sein (keine IP): Den Registrar mit IP-Domain verwirft Flexisip stillschweigend,
## wenn die IP nicht ihm selbst gehört. Weitergeleitet wird per Route an die IP der Anlage (CME_IP).
## Flexisip ist Registrar für alle Apps einer Nummer (iPhone, iPad). Das REGISTER geht zur Passwortprüfung
## an cme-web (sharedline.py, Pool MOB<Nummer>); Flexisip registriert das Gerät erst lokal, wenn cme-web mit
## 200 OK antwortet (reg-on-response). An CME meldet cme-web EINEN Pool MOB<Nummer> mit Flexisip als Ziel an
## und hält dafür das Shared-Line-Abo. CME ruft dann sip:<nummer>@${HOST_IP}:${SIP_PORT} an, Flexisip weckt
## und klingelt alle Apps der Nummer parallel an. (Der Mac meldet sich wie Jabber direkt an CME an.)
##
## Vorlage: entrypoint.sh setzt beim Start die Werte aus dem Stack ein und schreibt /etc/flexisip/flexisip.conf
##   ${HOST_IP}      LAN-IP des Docker-Hosts (VM_HOST_IP)
##   ${SIP_GW_NAME}  DNS-Name, den die App als Gateway nutzt (leer = nur IP)
##   ${SIP_PORT}     SIP-Port von Flexisip (SIP_GW_PORT, Standard 5062)
##   ${RELAY_PORT}   HTTP-Port des push-relay auf 127.0.0.1 (RELAY_HTTP_PORT, Standard 8092)
## Eigene Anpassungen: Datei /etc/flexisip/flexisip.local.conf im Volume "flexisip-conf" anlegen –
## sie ersetzt dann die Vorlage komplett (Platzhalter werden auch dort ersetzt).
##

[global]
# FLEXISIP_LOG_LEVEL im Stack: debug, message, warning, error
log-level=${LOG_LEVEL}
# Namen/IPs, unter denen Flexisip SICH SELBST erkennt. NICHT die CME-IP eintragen!
aliases=${SIP_GW_NAME} ${HOST_IP}
# Eine Adresse für Clients und CME (alles im LAN/VPN).
# TLS: zusätzlich  sips:${HOST_IP}:5061  und tls-certificates-dir (s.u.) setzen.
transports=sip:${HOST_IP}:${SIP_PORT};transport=tcp sip:${HOST_IP}:${SIP_PORT};transport=udp
# tls-certificates-dir=/etc/flexisip/tls      # agent.pem (Zertifikat + Key), z.B. vom acme-Container
# Keepalive für TCP-Verbindungen der Telefone
keepalive-interval=30
idle-timeout=3600

[stun-server]
# Eingebauter STUN-Server (UDP 3478) wird nicht gebraucht – RTP läuft direkt im LAN/VPN.
enabled=false

[module::DoSProtection]
enabled=false

[module::Authentication]
# Digest für alle Anfragen der Apps (INVITE, re-INVITE, OPTIONS …): CME prüft Anrufe über Flexisip nicht, ohne
# diese Prüfung könnte jeder, der Flexisip erreicht, über die CME telefonieren. ACK/CANCEL/BYE prüft Flexisip nie.
# REGISTER prüft cme-web (sharedline.py) – hier ausgenommen. Anfragen der CME und von cme-web (127.0.0.1) sind
# vertrauenswürdig. Passwörter: cme-web schreibt sie ins Volume softphone-data, entrypoint.sh kopiert sie nach
# /run (Flexisip bricht ab, wenn die Datei fehlt oder nicht lesbar ist).
enabled=true
filter=is_request && request.method != 'REGISTER'
trusted-hosts=${CME_IP} 127.0.0.1
# From-Domain der Apps: SIP-Domain, CME-IP (Übernehmen) oder Flexisip-IP (eingehend) – Realm immer die SIP-Domain
auth-domains=*
realm=${SIP_DOMAIN}
db-implementation=file
file-path=/run/flexisip-passwd
# Datei alle 60 s neu lesen (neue Geräte, neue Passwörter aus cme-web)
cache-expire=60

[module::Authorization]
# Flexisip 2.6: Standardwert "legacy" ist veraltet und erzeugt eine Warnung.
enabled=false
auth-domains-mode=static

[module::NatHelper]
enabled=true

[module::ContactRouteInserter]
enabled=true
# Domain (nicht Geräte-IP) im CtRt-Parameter – nötig für reg-domains=* (Push-Gateway-Modus)
insert-domain=true
masquerade-contacts-on-registers=true
masquerade-contacts-for-invites=false

[module::Registrar]
enabled=true
reg-domains=*
# Gerät erst lokal registrieren, wenn cme-web (Passwortprüfung) 200 OK antwortet
reg-on-response=true
# Keine GRUU: sonst schickt Flexisip CME die GRUU (…@${SIP_DOMAIN};gr=…) als Contact und die App nutzt sie in
# SUBSCRIBE/INVITE – Folge-Requests von CME (NOTIFY, BYE) gingen dann per Domain-Route zurück an CME (481).
enable-gruu=false
# Apps mit Push (iPhone/iPad) erneuern die Anmeldung im Hintergrund nicht – sie muss bis zum nächsten Öffnen gelten
max-expires=604800
min-expires=60
# Bindings im Speicher genügen (bei Neustart registriert die App sich neu). Alternativ Redis:
db-implementation=internal

[module::Router]
# Nur Requests an die Apps laufen durch Router/Push, alles andere (REGISTER, ausgehende Anrufe)
# geht direkt weiter zur CME. CME verwirft die URI-Parameter des Contacts (doroute/CtRt) und schickt
# Anrufe an sip:<nummer>@${HOST_IP}:${SIP_PORT} – deshalb auch alles an unsere eigene IP routen.
# REFER von CME (Jabber-Steuerung) bewusst NICHT an die Apps: Nimmt ein Client ihn an, behandelt CME ihn
# wie einen echten Cisco-Client und stellt Anrufe auf Shared Lines nur noch nach Cisco-eigenem Abo zu.
# NOTIFY/OPTIONS der CME (service-control, Keepalive) gehen ebenfalls nicht an die Apps (würde sie per Push
# wecken), sondern per Route an cme-web, das sie bestätigt (entrypoint.sh).
filter=(is_request && request.method != 'REFER' && request.method != 'NOTIFY' && request.method != 'OPTIONS' && (request.uri.params contains 'doroute' || request.uri.domain == '${HOST_IP}')) || is_response
# Bindings unabhängig von der Domain: die App meldet sich als <nummer>@${SIP_DOMAIN} an,
# CME ruft <nummer>@${HOST_IP} an
use-global-domain=true
fork-late=true
# Wie lange auf das per Push geweckte Gerät gewartet wird (CME-Rufzeit ist meist kürzer)
call-fork-timeout=30

[module::PushNotification]
enabled=true
# Kein eigener APNs-/Firebase-Versand in Flexisip (sonst sucht es /etc/flexisip/apn)
apple=false
firebase=false
# Flexisip spricht NICHT selbst mit Apple, sondern übergibt an cme-push-relay.
# Der Relay entscheidet: Local Push (Heim-WLAN) oder APNs.
external-push-uri=http://127.0.0.1:${RELAY_PORT}/push?type=$type&token=$token&app-id=$app-id&from-name=$from-name&from-uri=$from-uri&to-uri=$to-uri&call-id=$call-id&event=$event&uid=$uid
external-push-method=GET
# Standard wäre HTTP/2 – der Relay (aiohttp) spricht HTTP/1.1
external-push-protocol=http
display-from-uri=true

[module::MediaRelay]
# Medien gehen direkt Telefon <-> CME/Telefon (LAN oder VPN). Für Betrieb ohne VPN
# über das Internet hier enabled=true setzen und RTP-Portbereich in der Firewall öffnen.
enabled=false

[module::Forward]
enabled=true
# REGISTER und Anrufe der Apps (Domain ${SIP_DOMAIN}) per Route an CME – entrypoint.sh schreibt die Datei.
routes-config-path=/run/flexisip-routes.conf
