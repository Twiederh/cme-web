##
## Flexisip als Push-Gateway vor Cisco CME
## =========================================
##
##  iPhone/iPad/Mac (liblinphone)  --REGISTER/INVITE-->  Flexisip (Docker-Host)  --REGISTER/INVITE-->  CME
##                                                      |
##                                                      +-- schläft das Gerät: HTTP -> cme-push-relay
##                                                          -> Local Push (Heim-WLAN) oder APNs VoIP-Push
##
## Die App registriert sich mit Identität sip:<nst>@<CME> und nutzt Flexisip als Outbound-Proxy.
## Flexisip leitet das REGISTER an CME weiter (Request-URI = CME), ersetzt dabei den Contact durch
## seine eigene Adresse (ContactRouteInserter) und registriert das Gerät erst lokal,
## wenn CME mit 200 OK antwortet (reg-on-response).
##
## Vorlage: entrypoint.sh setzt beim Start die Werte aus dem Stack ein und schreibt /etc/flexisip/flexisip.conf
##   ${HOST_IP}      LAN-IP des Docker-Hosts (VM_HOST_IP)
##   ${SIP_GW_NAME}  DNS-Name, den die App als Gateway nutzt (leer = nur IP)
##   ${SIP_PORT}     SIP-Port von Flexisip (SIP_GW_PORT, Standard 5062)
##   ${RELAY_PORT}   HTTP-Port des push-relay auf 127.0.0.1 (RELAY_HTTP_PORT, Standard 8092)
## Eigene Anpassungen: Datei /etc/flexisip/flexisip.local.conf im Volume "flexisip-conf" anlegen –
## sie ersetzt dann die Vorlage komplett (Platzhalter werden auch dort ersetzt).
##

[global]
log-level=message
# Namen/IPs, unter denen Flexisip SICH SELBST erkennt. NICHT die CME-IP eintragen!
aliases=${SIP_GW_NAME} ${HOST_IP}
# Eine Adresse für Clients und CME (alles im LAN/VPN).
# TLS: zusätzlich  sips:${HOST_IP}:5061  und tls-certificates-dir (s.u.) setzen.
transports=sip:${HOST_IP}:${SIP_PORT};transport=tcp sip:${HOST_IP}:${SIP_PORT};transport=udp
# tls-certificates-dir=/etc/flexisip/tls      # agent.pem (Zertifikat + Key), z.B. vom acme-Container
# Keepalive für TCP-Verbindungen der Telefone
keepalive-interval=30
idle-timeout=3600

[stun-server]
# Eingebauter STUN-Server (UDP 3478) wird nicht gebraucht – RTP läuft direkt im LAN/VPN.
enabled=false

[module::DoSProtection]
enabled=false

[module::Authentication]
# CME authentifiziert selbst (bzw. gar nicht – Zuordnung über "id network" im Pool).
enabled=false

[module::Authorization]
# Flexisip 2.6: Standardwert "legacy" ist veraltet und erzeugt eine Warnung.
enabled=false
auth-domains-mode=static

[module::NatHelper]
enabled=true

[module::ContactRouteInserter]
enabled=true
# Domain (nicht Geräte-IP) im CtRt-Parameter – nötig für reg-domains=* (Push-Gateway-Modus)
insert-domain=true
masquerade-contacts-on-registers=true
masquerade-contacts-for-invites=false

[module::Registrar]
enabled=true
reg-domains=*
# Gerät erst lokal registrieren, wenn CME 200 OK antwortet
reg-on-response=true
max-expires=600
min-expires=60
# Bindings im Speicher genügen (bei Neustart registriert die App sich neu). Alternativ Redis:
db-implementation=internal

[module::Router]
# Nur Requests von CME (mit 'doroute' im Request-URI) laufen durch Router/Push,
# alles andere (REGISTER, ausgehende Anrufe) geht direkt weiter zur CME.
filter=(is_request && request.uri.params contains 'doroute') || is_response
fork-late=true
# Wie lange auf das per Push geweckte Gerät gewartet wird (CME-Rufzeit ist meist kürzer)
call-fork-timeout=30

[module::PushNotification]
enabled=true
# Kein eigener APNs-/Firebase-Versand in Flexisip (sonst sucht es /etc/flexisip/apn)
apple=false
firebase=false
# Flexisip spricht NICHT selbst mit Apple, sondern übergibt an cme-push-relay.
# Der Relay entscheidet: Local Push (Heim-WLAN) oder APNs.
external-push-uri=http://127.0.0.1:${RELAY_PORT}/push?type=$type&token=$token&app-id=$app-id&from-name=$from-name&from-uri=$from-uri&to-uri=$to-uri&call-id=$call-id&event=$event&uid=$uid
external-push-method=GET
# Standard wäre HTTP/2 – der Relay (aiohttp) spricht HTTP/1.1
external-push-protocol=http
display-from-uri=true

[module::MediaRelay]
# Medien gehen direkt Telefon <-> CME/Telefon (LAN oder VPN). Für Betrieb ohne VPN
# über das Internet hier enabled=true setzen und RTP-Portbereich in der Firewall öffnen.
enabled=false

[module::Forward]
enabled=true
